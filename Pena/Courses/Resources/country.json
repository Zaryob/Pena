  "glossary": [
    {
      "term": "Standart akort",
      "meaning": "Tellerin kalından inceye E-A-D-G-B-e seslerinde olması.",
      "exercise": "Her gün telleri kontrol et."
    },
    {
      "term": "Açık tel",
      "meaning": "Perdeye basmadan çalınan tel; 0 ile gösterilir.",
      "exercise": "D ve A açık tellerini çal."
    },
    {
      "term": "Perde",
      "meaning": "Sapta metal çizgilerin arasındaki basma yeri.",
      "exercise": "Kalın E telinde 3. perdeyi bul."
    },
    {
      "term": "Akor",
      "meaning": "Birden fazla notanın birlikte duyulması.",
      "exercise": "G tellerini ayrı, sonra birlikte çal."
    },
    {
      "term": "Bas nota",
      "meaning": "Akorun altında duyulan kalın tek ses.",
      "exercise": "G akorunda E3 çal."
    },
    {
      "term": "Alternatif bas",
      "meaning": "Aynı akor içinde iki farklı kalın sesin sırayla kullanılması.",
      "exercise": "G için E3-akor-D0-akor çal."
    },
    {
      "term": "Boom-chick",
      "meaning": "1 ve 3 bas, 2 ve 4 hafif akor hissinin sözlü ifadesi.",
      "exercise": "Bir ölçü bas-akor-bas-akor say."
    },
    {
      "term": "Metronom",
      "meaning": "Düzenli tıkla zamanı gösterir.",
      "exercise": "60 tempoda her tıkta bir sayı söyle."
    },
    {
      "term": "Ölçü",
      "meaning": "Bu planda dört vuruşluk zaman birimi.",
      "exercise": "1-2-3-4 sonra yeniden 1 de."
    },
    {
      "term": "Vurgu",
      "meaning": "Bazı vuruşları daha belirgin çalmak.",
      "exercise": "Basları akorlardan biraz belirgin çal."
    }
  ],
  "nextMonth": [
