    "settings.sensitivity.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you're in a noisy space, the 'Noisy Room' option keeps ambient sound from being mistaken for your guitar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gürültülü bir mekandaysanız 'Gürültülü Ortam' seçeneği, gitarınızın sessiz sesli ortam sesleriyle karışmasını önler."
          }
        }
      }
    },
    "settings.sensitivity.picker" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Room Noise"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ortam Gürültüsü"
          }
        }
      }
    },
    "settings.tip1.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Always approach the target pitch by tightening up from flat, never by loosening down from sharp — this keeps the tuning peg's gears seated without backlash."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telin tonunu her zaman pes (gevşek) taraftan sıkarak hedef sese getirin. Böylece kulakçık mekanizması boşluk yapmaz."
          }
        }
      }
    },
    "settings.tip1.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tune From Below"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aşağıdan Yukarı Akort Edin"
          }
        }
      }
    },
    "settings.tip2.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Classical guitar nylon strings are sensitive to temperature and humidity. Gently stretch newly installed strings and retune."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klasik gitar naylon telleri sıcaklık ve neme duyarlıdır. Yeni takılan telleri hafifçe esnetip tekrar akort edin."
          }
        }
      }
    },
    "settings.tip2.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nylon Strings Stretch"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naylon Teller Esner"
          }
        }
      }
    },
    "settings.tip3.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Holding the phone close to the guitar's body in a quiet room gives the clearest pitch reading."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gitarın gövdesine yakın tutarak ve sessiz bir ortamda akort yapmak en net frekans algısını sağlar."
          }
        }
      }
    },
